{
  "name": "redra",
  "private": true,
  "version": "0.4.0",
  "productName": "Redra",
  "description": "Open HTML. Click. Write. — a visual editor for HTML files.",
  "author": "redraaya",
  "license": "MIT",
  "homepage": "https://github.com/redraaya/Redra",
  "repository": {
    "type": "git",
    "url": "https://github.com/redraaya/Redra.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke tests/fixtures/sample-report.html",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "parse5": "^8.0.1",
    "typescript": "^5.5.0",
    "vite": "^7.3.5",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": false,
    "electron@42.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
