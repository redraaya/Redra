{
  "name": "redra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke tests/fixtures/sample-report.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "parse5": "^7.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^42.4.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.5",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "electron@42.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
